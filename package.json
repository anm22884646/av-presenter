{
  "name": "av-presenter",
  "version": "0.4.0",
  "private": true,
  "description": "Lightweight Windows and macOS event playback and overlay tool",
  "author": "AV Presenter",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "pack:win": "npm run build && electron-builder --win portable nsis",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "com.avpresenter.desktop",
    "productName": "AV Presenter",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "minimumSystemVersion": "12.0",
      "artifactName": "AV-Presenter-macOS-${arch}-${version}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "extraFiles": [
        {
          "from": "MACOS-VALIDATION.md",
          "to": "MACOS-VALIDATION.md"
        },
        {
          "from": "README.md",
          "to": "README.md"
        }
      ]
    }
  }
}
