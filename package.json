{
  "name": "av-presenter",
  "version": "0.2.0",
  "private": true,
  "description": "Lightweight Windows event playback and overlay tool",
  "author": "AV Presenter",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "pack:win": "npm run build && electron-builder --win portable nsis"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "com.avpresenter.desktop",
    "productName": "AV Presenter",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
